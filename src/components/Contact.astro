---
import { profile } from '../data/profile';
import { assetPath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section" id="contact">
  <div class="container">
    <p class="eyebrow">04</p>
    <h2 class="section-title">{t('contact.title')}</h2>
    <p class="section-intro">{t('contact.text')}</p>
    <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
    <div class="actions">
      <a class="btn" href={profile.linkedin}>LinkedIn</a>
      <a class="btn" href={profile.github}>GitHub</a>
      <a class="btn primary" href={assetPath(profile.cv[lang])} download>{t('hero.cv')} (PDF)</a>
    </div>
    <p class="location">{profile.location}</p>
  </div>
</section>

<style>
  .email {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: clamp(1.35rem, 4.5vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    text-decoration-thickness: 2px;
    word-break: break-word;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .location {
    margin: 2rem 0 0;
    color: var(--faint);
    font-size: 0.9rem;
  }
</style>
