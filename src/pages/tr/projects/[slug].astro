---
import type { GetStaticPaths } from 'astro';
import ProjectPage from '../../../views/ProjectPage.astro';
import { getProjects, projectSlug, type Project } from '../../../lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getProjects('tr');
  return projects.map((project) => ({ params: { slug: projectSlug(project) }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props as { project: Project };
---

<ProjectPage project={project} lang="tr" />
