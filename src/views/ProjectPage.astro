---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectMeta from '../components/ProjectMeta.astro';
import { getProjects, projectSlug, type Project } from '../lib/projects';
import { assetPath, localePath, otherLang, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(project);
const { title, tagline, highlights, pipeline, stack, links, media } = project.data;

const slug = projectSlug(project);
const path = `/projects/${slug}/`;

// Link the language switcher to the translated case study when it exists.
const translated = (await getProjects(otherLang(lang))).some((p) => projectSlug(p) === slug);

const siblings = await getProjects(lang);
const position = siblings.findIndex((p) => p.id === project.id);
const next = siblings.length > 1 ? siblings[(position + 1) % siblings.length] : undefined;

const linkList = [
  { href: links.repo, label: t('link.repo') },
  { href: links.demo, label: t('link.demo') },
  { href: links.video, label: t('link.video') },
  { href: links.docs, label: t('link.docs') },
].filter((l): l is { href: string; label: string } => Boolean(l.href));
---

<Base lang={lang} title={title} description={tagline} path={path} altPath={translated ? path : '/'}>
  <article>
    <header class="head">
      <div class="container">
        <a class="back" href={`${localePath(lang, '/')}#projects`}><span aria-hidden="true">←</span> {t('project.back')}</a>
        <ProjectMeta project={project} lang={lang} />
        <h1>{title}</h1>
        <p class="tagline">{tagline}</p>
        {
          linkList.length > 0 && (
            <div class="links">
              {linkList.map((l, i) => (
                <a class:list={['btn', { primary: i === 0 }]} href={l.href}>
                  {l.label} <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    {
      highlights.length > 0 && (
        <section class="container glance" aria-label={t('project.glance')}>
          <dl>
            {highlights.map((h) => (
              <div>
                <dt>{h.label}</dt>
                <dd>{h.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      media && (media.images.length > 0 || media.video) && (
        <section class="container media">
          {media.images[0] && (
            <figure class="media-still">
              <img
                src={assetPath(media.images[0].src)}
                alt={media.images[0].alt}
                loading="lazy"
                decoding="async"
              />
              {media.images[0].caption && <figcaption>{media.images[0].caption}</figcaption>}
            </figure>
          )}

          <div class="media-rest">
            {media.video && (
              <figure class="media-clip">
                {/* Not autoplayed: the point of this clip is its sound. */}
                <video
                  src={assetPath(media.video.src)}
                  poster={media.video.poster ? assetPath(media.video.poster) : undefined}
                  controls
                  preload="none"
                  playsinline
                />
                {media.video.caption && <figcaption>{media.video.caption}</figcaption>}
              </figure>
            )}

            {media.images[1] && (
              <figure class="media-extra">
                <img
                  src={assetPath(media.images[1].src)}
                  alt={media.images[1].alt}
                  loading="lazy"
                  decoding="async"
                />
                {media.images[1].caption && <figcaption>{media.images[1].caption}</figcaption>}
              </figure>
            )}
          </div>
        </section>
      )
    }

    <div class="container layout">
      <aside class="side">
        {
          pipeline.length > 0 && (
            <section>
              <h2 class="eyebrow">{t('project.flow')}</h2>
              <ol class="pipeline">
                {pipeline.map((p) => (
                  <li>
                    <strong>{p.step}</strong>
                    <span>{p.detail}</span>
                  </li>
                ))}
              </ol>
            </section>
          )
        }
        <section>
          <h2 class="eyebrow">{t('project.stack')}</h2>
          <ul class="chips">
            {stack.map((s) => <li class="chip">{s}</li>)}
          </ul>
        </section>
      </aside>

      <div class="prose">
        <Content />
      </div>
    </div>

    {
      next && (
        <nav class="container next" aria-label={t('project.next')}>
          <a href={localePath(lang, `/projects/${projectSlug(next)}/`)}>
            <span class="eyebrow">{t('project.next')}</span>
            <span class="next-title">
              {next.data.title} <span aria-hidden="true">→</span>
            </span>
          </a>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 2rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
  }

  h1 {
    margin: 0.9rem 0 0.9rem;
    font-size: clamp(2rem, 6vw, 3.4rem);
    letter-spacing: -0.03em;
    max-width: 52rem;
  }

  .tagline {
    margin: 0;
    max-width: 44rem;
    font-size: clamp(1.1rem, 2.4vw, 1.3rem);
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .glance dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  /* Divider lines drawn per cell, so an incomplete last row leaves no gray gap. */
  .glance div {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.4rem;
    box-shadow: -1px -1px 0 var(--line);
  }

  .glance dd {
    order: -1;
    margin: 0;
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .glance dt {
    font-size: 0.88rem;
    color: var(--muted);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: 4rem;
    align-items: start;
    padding-block: 1rem 4rem;
  }

  .layout .prose {
    grid-column: 1;
    grid-row: 1;
  }

  .side {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: 5.5rem;
    display: grid;
    gap: 2.5rem;
    padding-top: 3rem;
  }

  .pipeline {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
  }

  .pipeline li {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0 0 1.1rem 2.25rem;
    counter-increment: step;
    font-size: 0.9rem;
  }

  .pipeline li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 1px solid var(--accent);
    color: var(--accent);
    font: 600 0.72rem var(--font-mono);
    background: var(--bg);
  }

  .pipeline li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(0.75rem - 0.5px);
    top: 1.6rem;
    bottom: 0.1rem;
    width: 1px;
    background: var(--line);
  }

  .pipeline span {
    color: var(--muted);
    line-height: 1.45;
  }

  .next {
    padding-bottom: 4rem;
  }

  .next a {
    display: block;
    padding: 1.75rem 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
  }

  .next a:hover {
    border-color: var(--accent);
  }

  .next .eyebrow {
    display: block;
    margin-bottom: 0.25rem;
  }

  .next-title {
    font-size: 1.3rem;
    font-weight: 650;
  }

  @media (max-width: 900px) {
    .layout {
      /* minmax(0, …) stops wide code blocks from stretching the column past the screen. */
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .side {
      grid-column: 1;
      grid-row: 1;
      position: static;
    }
    .layout .prose {
      grid-row: 2;
    }
  }

  /* ── Media ─────────────────────────────────────────── */
  .media {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: 1.25rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }

  .media figure {
    margin: 0;
  }

  .media img,
  .media video {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .media figcaption {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .media-rest {
    display: grid;
    gap: 1.25rem;
  }

  @media (max-width: 760px) {
    .media {
      grid-template-columns: 1fr;
    }
  }
</style>
